# The OAuth client (web application) in your Google Cloud project.
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
# The account's refresh token (authorization code flow, access_type=offline).
GOOGLE_WORKSPACE_REFRESH_TOKEN=
GOOGLE_WORKSPACE_TIMEOUT_MS=30000
GOOGLE_WORKSPACE_MAX_CONCURRENCY=4
# Largest response body read from Google (bytes, max 104857600).
GOOGLE_WORKSPACE_MAX_RESPONSE_BYTES=10485760

# Write tools are disabled unless this is true.
GOOGLE_WORKSPACE_ENABLE_WRITES=false
# Comma-separated tool names to disable (with or without the google_ prefix).
GOOGLE_WORKSPACE_DISABLED_TOOLS=
# JSONL audit trail; write tools refuse to run if it cannot be written.
GOOGLE_WORKSPACE_AUDIT_LOG=

# HTTP transport. A bearer token (>= 32 printable ASCII characters, e.g.
# `openssl rand -hex 32`) is required unless the server binds to loopback.
MCP_HTTP_TOKEN=
# Bind address (HOST is also read; MCP_HTTP_HOST wins):
# MCP_HTTP_HOST=127.0.0.1
# PORT=3000
# MCP_ALLOWED_ORIGINS=
# MCP_ALLOWED_HOSTS=
# MCP_MAX_BODY_BYTES=10485760
# MCP_AUTH_FAILURE_LIMIT=20
# MCP_AUTH_FAILURE_WINDOW_MS=60000
# Allow any browser origin (requires a token):
# MCP_ALLOW_ANY_ORIGIN=false
# Non-loopback bind without a token; isolated networks only:
# MCP_HTTP_ALLOW_UNAUTHENTICATED=false
