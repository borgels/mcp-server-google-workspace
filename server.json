{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.borgels/mcp-server-google-workspace",
  "title": "Google Workspace",
  "description": "MCP server for Google Calendar, Sheets, Docs, Contacts and Tasks, without restricted scopes.",
  "repository": {
    "url": "https://github.com/borgels/mcp-server-google-workspace",
    "source": "github"
  },
  "version": "0.5.1",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@borgels/mcp-server-google-workspace",
      "version": "0.5.1",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "GOOGLE_WORKSPACE_CLIENT_ID",
          "description": "OAuth client id of your Google Cloud project.",
          "isRequired": true
        },
        {
          "name": "GOOGLE_WORKSPACE_CLIENT_SECRET",
          "description": "OAuth client secret.",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "GOOGLE_WORKSPACE_REFRESH_TOKEN",
          "description": "The account's OAuth refresh token.",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "GOOGLE_WORKSPACE_ENABLE_WRITES",
          "description": "Enable the write tools.",
          "format": "boolean",
          "default": "false"
        },
        {
          "name": "GOOGLE_WORKSPACE_DISABLED_TOOLS",
          "description": "Comma-separated tool names to disable."
        },
        {
          "name": "GOOGLE_WORKSPACE_AUDIT_LOG",
          "description": "Path of the JSONL audit log. Write tools refuse to run if it cannot be written.",
          "format": "filepath"
        }
      ]
    }
  ]
}
